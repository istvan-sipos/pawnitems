/* PE VERSIONINFO resource for pawnitems.dll. */
#include <winver.h>

#ifndef PAWNITEMS_VER_NUM
#define PAWNITEMS_VER_NUM 0,0,0,0
#endif
#ifndef PAWNITEMS_VER_STR
#define PAWNITEMS_VER_STR "dev"
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    PAWNITEMS_VER_NUM
 PRODUCTVERSION PAWNITEMS_VER_NUM
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_DLL
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904E4"
        BEGIN
            VALUE "CompanyName",      "Istvan Sipos"
            VALUE "FileDescription",  "Dragon's Dogma: Dark Arisen, a mod to allow item equip/unequip for support pawns"
            VALUE "FileVersion",      PAWNITEMS_VER_STR
            VALUE "InternalName",     "pawnitems"
            VALUE "LegalCopyright",   "MIT License - see LICENSE"
            VALUE "OriginalFilename", "pawnitems.dll"
            VALUE "ProductName",      "pawnitems"
            VALUE "ProductVersion",   PAWNITEMS_VER_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04E4
    END
END
